# remedy-bridge — stack environment template.
# Copy to remedy-bridge.env and fill in. Never commit the filled copy.
#
# The full list of tunables is in the libretexts-remedy-bridge repository's own
# .env.example.

# --- CXone Expert (MindTouch) service account ---------------------------------
# All three are required. Placeholder values do not fail at startup — the
# bridge starts fine and then returns 403 on the first page fetch.
SERVER_DOMAIN=REPLACE_WITH_CXONE_HOST
SERVER_KEY=REPLACE_WITH_CXONE_SERVER_KEY
SERVER_SECRET=REPLACE_WITH_CXONE_SERVER_SECRET
SERVER_USER=REPLACE_WITH_CXONE_SERVICE_ACCOUNT

# --- Write guard --------------------------------------------------------------
# Regex of CXone namespaces the bridge is allowed to write to. Anything outside
# it raises WriteNotAllowedError *before* any HTTP call is made.
# Widen this deliberately — it is the main blast-radius control.
REMEDY_WRITE_ALLOWLIST=^Sandboxes/

# Append-only record of every applied write: before/after hashes, snapshot
# path, CXone revision id, operator, ISO timestamp.
REMEDY_AUDIT_LOG=/data/audit.log

# --- LLM backend for fix suggestions -----------------------------------------
# Set REMEDY_LLM_PROVIDER to the one you are using, then fill only that key.
REMEDY_LLM_PROVIDER=REPLACE_WITH_PROVIDER
REMEDY_TEXT_MODEL=REPLACE_WITH_MODEL_ID
REMEDY_VISION_MODEL=REPLACE_WITH_MODEL_ID
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=

# --- Limits -------------------------------------------------------------------
REMEDY_MAX_REQUEST_BYTES=6291456
# Comma-separated host allowlist for fetching images referenced by a page.
REMEDY_IMAGE_FETCH_ALLOWLIST=REPLACE_WITH_IMAGE_HOSTS

# Conductor's API host, when the staff panel is in use.
CONDUCTOR_API_HOST=
