# Actual published Bridge configuration; choose profile through Compose's
# REMEDY_BRIDGE_PROFILE. No default/inferred review-only mode.
NODE_ENV=production
CONDUCTOR_API_HOST=127.0.0.1
REMEDY_REVIEWER_REQUIRED=true
REMEDY_BRIDGE_SERVICE_KEY_FILE=/run/secrets/service
CXONE_INTEGRATION_ENABLED=true
# Existing reviewed host/root restriction, not an arbitrary tenant allowlist.
# Any future target/adapter/policy expansion requires separate review.
SERVER_DOMAIN=dev.libretexts.org
SERVER_KEY_FILE=/run/secrets/key
SERVER_SECRET_FILE=/run/secrets/secret
SERVER_USER_FILE=/run/secrets/user
REMEDY_WRITE_ALLOWLIST=^Sandboxes/johnnyphung(?:/|$)
REMEDY_MAX_REQUEST_BYTES=5000000
REMEDY_WORK_ACTIVE=1
REMEDY_WORK_QUEUED=8
REMEDY_WORK_TIMEOUT_MS=120000
HOME=/tmp
NPM_CONFIG_CACHE=/tmp/npm
# Review scan/preview needs no writer keyring or ledger. Optional historical
# status needs its separate existing store/issuer/fence configuration.
# REMEDY_REVIEWER_TRUST_EPOCH is optional NONSECRET recovery context shared with
# Conductor; it is separate from signer settings and never enables writes.
