# remedy-server — stack environment template.
# Copy to remedy-server.env and fill in. Never commit the filled copy.
#
# This is the subset the stack needs. The full list of tunables (quality-judge
# backends, job retention, corpus paths, upload caps) is in the repository root
# .env.example — defaults there are fine for a first deployment.

APP_ENV=production
APP_DOCS_ENABLED=false

# Shared secret. adapt-scanner MUST send this identical value as REMEDY_API_KEY.
APP_API_KEY=REPLACE_WITH_RANDOM_SECRET

# LLM backend used for AI-assisted fix suggestions.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=REPLACE_WITH_OLLAMA_API_KEY
OLLAMA_MODEL=REPLACE_WITH_MODEL_ID
OLLAMA_VISION_MODEL=REPLACE_WITH_MODEL_ID
OLLAMA_ESCALATION_MODEL=REPLACE_WITH_MODEL_ID

# Browser origins permitted to call /v1/* — normally Conductor's URL.
# Comma-separated. Do not use "*" with an API key in play.
CORS_ALLOW_ORIGINS=REPLACE_WITH_CONDUCTOR_ORIGIN

# CXone page scanning is delegated to remedy-bridge over the shared network.
# Leave these as-is unless you renamed the bridge service.
CXONE_INTEGRATION_ENABLED=true
CXONE_BRIDGE_BASE_URL=http://remedy-bridge:5175
CXONE_BRIDGE_TIMEOUT_SECONDS=120

# Container paths — these match the volume mounts in docker-compose.yml.
# Change them only if you change the mounts too.
JOB_DIR=/app/job_data
JOB_STORE_PATH=/app/state/jobs.db
JOB_BACKUP_DIR=/app/state/job_backups
OUTPUT_DIR=/app/state/output
LOG_DIR=/app/state/logs
LOG_FORMAT=json
