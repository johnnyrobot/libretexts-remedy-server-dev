# Nonsecret settings only. secret-env.mjs reads the named private files.
APP_ENV=production
APP_DOCS_ENABLED=false
PYTHON_DOTENV_DISABLED=1
APP_API_KEY_FILE=/run/secrets/app
OLLAMA_API_KEY_FILE=/run/secrets/ollama
OLLAMA_BASE_URL=https://ollama.com/v1
CORS_ALLOW_ORIGINS=https://REPLACE_WITH_REVIEWED_CONDUCTOR_ORIGIN
JOB_DIR=/app/state/jobs
JOB_STORE_PATH=/app/state/jobs.sqlite3
JOB_BACKUP_DIR=/app/state/backups
OUTPUT_DIR=/app/state/output
LOG_DIR=/app/state/logs
HOME=/tmp
TMPDIR=/tmp
MAX_UPLOAD_MB=4
MAX_REQUEST_BYTES=5000000
WORKER_CONCURRENCY=1
WORKER_MAX_PENDING=8
JOB_TOTAL_TIMEOUT_SECONDS=900
CXONE_BRIDGE_TIMEOUT_SECONDS=130
REMEDY_REVIEWER_REQUIRED=true
