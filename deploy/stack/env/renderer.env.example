# The exact Bridge-owned renderer image runs as UID 1001 with its sandbox on.
# Public CA-only NSS seed is mounted read-only and copied into private tmpfs HOME.
NODE_ENV=production
HOME=/tmp/renderer-home
TMPDIR=/tmp
RENDER_SCANNER_TOKEN_FILE=/run/secrets/token
RENDER_SCANNER_PORT=5180
RENDER_ALLOWED_HOSTS=dev.libretexts.org
# No ignored certificate errors, sandbox disabling or expanded resource hosts.
