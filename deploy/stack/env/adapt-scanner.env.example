# adapt-a11y-scanner — stack environment template.
# Copy to adapt-scanner.env and fill in. Never commit the filled copy.

# --- ADAPT instance -----------------------------------------------------------
ADAPT_BASE_URL=REPLACE_WITH_ADAPT_URL

# Service-account JWT, set as ADAPT's `token` cookie. Preferred in production.
# ADAPT_EMAIL / ADAPT_PASSWORD exist as a dev-only fallback — see the
# repository's own .env.example.
ADAPT_TOKEN=REPLACE_WITH_ADAPT_SERVICE_JWT

# `iframe` renders /api/get-header-html/{id} directly and is faster.
# `spa` drives the full Vue app — slower, use only if iframe rendering misses
# something you need to scan.
RENDER_MODE=iframe
MATHJAX_TIMEOUT_MS=30000
NAV_TIMEOUT_MS=60000

# --- Remedy backend -----------------------------------------------------------
# `http` posts the captured DOM to remedy-server. `in-process` uses a bundled
# copy of remedy-core and is DEV-ONLY — it drifts from the server's rule set.
SCAN_MODE=http

# Container DNS name on the shared `libretexts_remedy` network.
REMEDY_ENDPOINT=http://remedy-server:8000/v1/validate/html

# MUST be byte-identical to APP_API_KEY in remedy-server.env.
# A mismatch surfaces only at scan time, as 401 on every request.
REMEDY_API_KEY=REPLACE_WITH_SAME_VALUE_AS_APP_API_KEY

REMEDY_TIMEOUT_MS=240000

# Port the scanner's HTTP mode listens on. The compose healthcheck and the
# `expose:` entry both assume 5176 — change all three together or none.
SCANNER_PORT=5176

# Set to 1 ONLY when the container runs as root. Otherwise leave the Chromium
# sandbox enabled.
CHROMIUM_NO_SANDBOX=0
