# Nonsecret settings only. The bundle wrapper maps these FILE inputs to the
# existing Scanner environment; do not add plaintext credential values.
ADAPT_BASE_URL=https://REPLACE_WITH_AUTHORIZED_ADAPT_HOST
ADAPT_TOKEN_FILE=/run/secrets/adapt
SCANNER_API_KEY_FILE=/run/secrets/api
REMEDY_API_KEY_FILE=/run/secrets/remedy
SCAN_MODE=http
RENDER_MODE=iframe
REMEDY_ENDPOINT=http://remedy-server:8000/v1/validate/html
REMEDY_TIMEOUT_MS=920000
SCANNER_PORT=5176
SCANNER_MAX_REQUEST_BYTES=5000000
SCANNER_MAX_ACTIVE_JOBS=1
SCANNER_MAX_QUEUED_JOBS=8
SCANNER_JOB_TIMEOUT_MS=900000
MATHJAX_TIMEOUT_MS=20000
NAV_TIMEOUT_MS=30000
HOME=/tmp
TMPDIR=/tmp
# Never set CHROMIUM_NO_SANDBOX or SCANNER_ALLOW_UNAUTHENTICATED.
