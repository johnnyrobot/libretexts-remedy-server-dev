# Nonsecret settings for the ORIGINAL compiled, target-specific Conductor image.
# Replace reviewed origin/provider metadata; credentials stay in private FILEs.
NODE_ENV=production
APP_ENV=production
ORG_ID=libretexts
REMEDY_ORG_ID=libretexts
REMEDY_ENABLED=true
PORT=5000
TRUST_PROXY_HOPS=0
# Coordinate the exact origin/JWT issuer policy and private TLS ingress first.
PRODUCTIONURLS=REPLACE_WITH_REVIEWED_CONDUCTOR_HOST,https://REPLACE_WITH_REVIEWED_CONDUCTOR_HOST
SECRETKEY_FILE=/run/secrets/session
MONGOOSEURI_FILE=/run/secrets/mongo
REMEDY_API_KEY_FILE=/run/secrets/remedy
OPENAI_API_KEY_FILE=/run/secrets/openai
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe
MAILGUN_API_KEY_FILE=/run/secrets/mailgun
MAILGUN_DOMAIN=REPLACE_WITH_AUTHORIZED_MAILGUN_DOMAIN
NEW_RELIC_ENABLED=false
NODE_EXTRA_CA_CERTS=/run/tls/ca.pem
REMEDY_API_BASE_URL=https://remedy-server:8000
HOME=/tmp
TMPDIR=/tmp
# No signer or epoch is needed for scan/preview startup. Optional overlays supply
# existing historical-status and seven existing signer settings separately.
