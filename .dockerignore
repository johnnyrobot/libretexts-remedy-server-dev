# Git + GitHub
.git
.github
.gitignore

# Python / uv caches
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
*.egg-info
dist
build

# Test + dev artifacts
tests
!tests/
tests/*
!tests/unit/
tests/unit/*
!tests/unit/*.py
!tests/unit/contracts_v1/
tests/unit/contracts_v1/*
!tests/unit/contracts_v1/remedy-html-validation.json
!tests/unit/contracts_v1/adapt-assignment-enumeration.json
!tests/unit/contracts_v1/integration-targets.json
!tests/unit/contracts_v1/lt-1-reviewer-wire-v1-vectors.json
