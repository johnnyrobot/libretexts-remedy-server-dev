docs
benchmarks
exports
output
reports
data
logs
tmp
job_data
jobs.db*
pipeline.db*

# Editor / OS noise
.vscode
.idea
.DS_Store
*.swp
*.swo

# Env files (never bake secrets into the image)
.env
.env.*

# Docker config (don't recurse into self)
Dockerfile
docker-compose.yml
.dockerignore

# Deploy-system sources (copied separately if needed)
deploy

# Playwright cache — built inside the image
.playwright-mcp
.firecrawl

# Local checker dependencies are installed from the pinned lock in the build.
**/node_modules

# Private source worktrees and build/proof outputs are never image inputs.
.scratch
.stack-inputs
.stack-artifacts
.stack-proof-evidence
